# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.venv/

# Untracked source notebooks and exploratory copies are kept outside the
# reproducibility package.
notebooks/legacy_unmodified/

# Large analysis data are distributed through GEO rather than this repository.
*.h5ad
*.h5Seurat
*.rds
*.RData
*.rda
*.loom
*.mtx
*.fastq
*.fastq.gz
*.bam
*.bai
*.cram
*.h5

# Generated outputs
outputs/*
!outputs/.gitkeep
figures/generated/
tables/generated/

# Local system files and temporary office files
.DS_Store
.Rhistory
**/.DS_Store
**/.Rhistory
~$*.xlsx
*.tmp
